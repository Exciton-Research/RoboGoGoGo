{
  "name": "robogogogo-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "screenshots": "node scripts/capture-docs.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack && node scripts/package-static.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src app scripts tests next.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src app scripts tests next.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
