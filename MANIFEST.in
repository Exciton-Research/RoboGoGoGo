recursive-include studio/scripts *.mjs
recursive-include studio/tests *.mjs
recursive-include studio/public *.svg
recursive-include docs *.md *.json *.png
recursive-include examples *.py *.json *.urdf *.zip
recursive-include tests *.py
recursive-include src/robogogogo/web *
recursive-include src/robogogogo/assets *.urdf
