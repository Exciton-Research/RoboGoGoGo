include LICENSE NOTICE THIRD_PARTY_NOTICES.md README.md CONTRIBUTING.md SECURITY.md
include scripts/setup.sh scripts/check_release.py
include studio/package.json studio/package-lock.json studio/next.config.ts studio/tsconfig.json studio/next-env.d.ts
recursive-include studio/app *.tsx *.css
